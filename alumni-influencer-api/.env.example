#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------

CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

app.baseURL = 'http://localhost:8080/'

#--------------------------------------------------------------------
# DATABASE (PostgreSQL)
#--------------------------------------------------------------------

database.default.DBDriver = Postgre
database.default.hostname = localhost
database.default.database = your_database_name
database.default.schema   = public
database.default.username = postgres
database.default.password = your_database_password
database.default.port     = 5432
database.default.DBPrefix =
database.default.pConnect = false
database.default.DBDebug  = true
database.default.charset  = utf8
database.default.DSN      =

#--------------------------------------------------------------------
# JWT AUTHENTICATION
#--------------------------------------------------------------------

jwt.secret = your_jwt_secret_key_here
# jwt.algo   = HS256
# jwt.ttl    = 3600
# jwt.issuer = http://localhost:8080/

#--------------------------------------------------------------------
# EMAIL (SMTP)
#--------------------------------------------------------------------

email.fromEmail = your_email@iit.ac.lk
email.fromName  = Alumni Influencer Platform
email.protocol  = smtp
email.SMTPHost  = smtp.gmail.com
email.SMTPUser  = your_email@iit.ac.lk
email.SMTPPass  = your_app_password_here
email.SMTPPort  = 587
email.SMTPCrypto = tls

#--------------------------------------------------------------------
# ENCRYPTION
#--------------------------------------------------------------------

# encryption.key =

#--------------------------------------------------------------------
# SESSION
#--------------------------------------------------------------------

# session.driver   = 'CodeIgniter\Session\Handlers\FileHandler'
# session.savePath = null

